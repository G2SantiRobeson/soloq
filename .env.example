# Demo is explicit and never writes to the database.
DEMO_MODE=true
DATABASE_URL=
RIOT_API_KEY=
# At least 16 characters. Use a unique, generated password.
ADMIN_PASSWORD=
# At least 32 random characters; rotating this invalidates all sessions.
ADMIN_SESSION_SECRET=
# At least 32 random characters.
CRON_SECRET=
APP_URL=http://localhost:3000
# Optional. Automatic latest Data Dragon version by default.
DDRAGON_VERSION=
# Conservative development-key pacing: at most one request per 1300ms.
RIOT_REQUEST_INTERVAL_MS=1300
# Set true only AFTER a real external scheduler is configured for this environment.
# This flag does not create a scheduler. Vercel Preview does not execute Vercel cron.
LADDER_SCHEDULER_ENABLED=false
