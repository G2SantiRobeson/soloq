{
  "name": "soloq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "icons:sync": "node scripts/sync-champion-icons.mjs",
    "ranks:sync": "node scripts/sync-rank-icons.mjs",
    "predev": "npm run icons:sync && npm run ranks:sync",
    "prebuild": "npm run icons:sync && npm run ranks:sync",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:backfill-remakes": "node --conditions=react-server --import tsx scripts/backfill-remakes.ts"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "drizzle-orm": "0.45.3",
    "postgres": "^3.4.7",
    "zod": "^4.3.6",
    "server-only": "0.0.1",
    "lucide-react": "1.52.0",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "@types/node": "^22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "drizzle-kit": "0.31.11",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "dotenv": "18.0.5",
    "vitest": "5.0.3",
    "@electric-sql/pglite": "0.5.8"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
